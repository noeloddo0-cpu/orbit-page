{
  "id": "studio",
  "name": "Studio",
  "description": "Une interface de bibliothèque sobre, nette et professionnelle.",
  "tokens": {
    "--bg": "#171918",
    "--surface": "#202321",
    "--surface-2": "#292d2a",
    "--fg": "#f1f2ed",
    "--muted": "#a3aaa3",
    "--accent": "#a9c2ad",
    "--line": "rgba(226,232,225,.13)",
    "--glass": "rgba(31,35,32,.96)",
    "--radius-card": "14px",
    "--radius-panel": "18px",
    "--radius-control": "9px",
    "--shadow-card": "0 8px 22px rgba(0,0,0,.22)",
    "--shadow-panel": "0 20px 55px rgba(0,0,0,.42)",
    "--theme-blur": "none",
    "--theme-glow": "none",
    "--space-unit": "8px",
    "--font-family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "--font-weight": "500",
    "--title-size": "clamp(34px,5vw,54px)",
    "--tile-scale": "1.012",
    "--focus-ring": "0 0 0 2px #a9c2ad"
  },
  "animations": {
    "introStyle": "minimal",
    "introDurationMs": 1800,
    "screenDurationMs": 260,
    "themeChangeMs": 300,
    "hoverDurationMs": 150,
    "hoverScale": 1.012,
    "focusScale": 1.008,
    "easing": "cubic-bezier(.2,.7,.2,1)",
    "stepped": false
  },
  "sounds": {
    "intro": {
      "wave": "sine",
      "startHz": 110,
      "endHz": 280,
      "durationMs": 320,
      "gain": 0.035
    },
    "click": {
      "wave": "sine",
      "startHz": 480,
      "endHz": 560,
      "durationMs": 55,
      "gain": 0.025
    },
    "open": {
      "wave": "triangle",
      "startHz": 180,
      "endHz": 330,
      "durationMs": 120,
      "gain": 0.04
    },
    "back": {
      "wave": "sine",
      "startHz": 360,
      "endHz": 220,
      "durationMs": 100,
      "gain": 0.03
    }
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "weight": 500,
    "titleSize": "clamp(34px,5vw,54px)",
    "bodySize": "14px"
  },
  "effects": {
    "backdropFilter": "none",
    "grain": false,
    "grainOpacity": 0,
    "scanlines": false,
    "reflections": false,
    "blurOnLowPower": true,
    "contrast": "dark"
  }
}
