{
  "id": "liquid-glass",
  "name": "Liquid Glass",
  "description": "Verre optique sur fond pétrole, reflets menthe et jaquettes plein cadre.",
  "tokens": {
    "--bg": "#08171a",
    "--surface": "#10282c",
    "--surface-2": "#1d383c",
    "--fg": "#e8f6f1",
    "--muted": "#afc9c2",
    "--accent": "#9ee2ce",
    "--line": "rgba(185,232,222,.26)",
    "--glass": "rgba(14,37,39,.82)",
    "--radius-card": "20px",
    "--radius-panel": "20px",
    "--radius-control": "10px",
    "--shadow-card": "0 3px 7px rgba(0,12,16,.22)",
    "--shadow-panel": "0 4px 8px rgba(0,12,16,.28)",
    "--theme-blur": "blur(10px)",
    "--theme-glow": "none",
    "--space-unit": "8px",
    "--font-family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "--font-weight": "500",
    "--title-size": "clamp(38px,6vw,64px)",
    "--tile-scale": "1.035",
    "--focus-ring": "0 0 0 2px #9ee2ce"
  },
  "animations": {
    "introStyle": "glass",
    "introDurationMs": 1600,
    "screenDurationMs": 250,
    "hoverDurationMs": 160,
    "hoverScale": 1.035,
    "focusScale": 1.025,
    "easing": "cubic-bezier(.2,.9,.25,1.18)",
    "stepped": false
  },
  "sounds": {
    "intro": {
      "wave": "sine",
      "startHz": 150,
      "endHz": 620,
      "durationMs": 700,
      "gain": 0.15
    },
    "click": {
      "wave": "sine",
      "startHz": 680,
      "endHz": 920,
      "durationMs": 95,
      "gain": 0.09
    },
    "open": {
      "wave": "triangle",
      "startHz": 260,
      "endHz": 780,
      "durationMs": 210,
      "gain": 0.13
    },
    "back": {
      "wave": "sine",
      "startHz": 520,
      "endHz": 190,
      "durationMs": 180,
      "gain": 0.12
    }
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "weight": 500,
    "titleSize": "clamp(38px,6vw,64px)",
    "bodySize": "15px"
  },
  "effects": {
    "backdropFilter": "blur(10px) saturate(1.5)",
    "grain": false,
    "grainOpacity": 0,
    "scanlines": false,
    "reflections": true,
    "blurOnLowPower": true,
    "contrast": "dark"
  }
}
