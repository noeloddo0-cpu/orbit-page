{
  "id": "apple-tv",
  "name": "Apple TV",
  "description": "Rangée de cartes et grille de jeux avec relief et parallaxe légère.",
  "tokens": {
    "--bg": "#030304",
    "--surface": "#111113",
    "--surface-2": "#1c1c1e",
    "--fg": "#f5f5f7",
    "--muted": "#a1a1a6",
    "--accent": "#b9c6ff",
    "--line": "rgba(255,255,255,.1)",
    "--glass": "rgba(28,28,30,.78)",
    "--radius-card": "12px",
    "--radius-panel": "18px",
    "--radius-control": "10px",
    "--shadow-card": "0 5px 8px rgba(0,0,0,.3)",
    "--shadow-panel": "0 34px 90px rgba(0,0,0,.62)",
    "--theme-blur": "blur(8px)",
    "--theme-glow": "none",
    "--space-unit": "8px",
    "--font-family": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif",
    "--font-weight": "560",
    "--title-size": "clamp(36px,5.5vw,60px)",
    "--tile-scale": "1.025",
    "--focus-ring": "0 0 0 3px rgba(185,198,255,.8)"
  },
  "animations": {
    "introStyle": "cinema",
    "introDurationMs": 2700,
    "screenDurationMs": 360,
    "hoverDurationMs": 240,
    "hoverScale": 1.025,
    "focusScale": 1.02,
    "easing": "cubic-bezier(.2,.75,.25,1)",
    "stepped": false
  },
  "sounds": {
    "intro": {
      "wave": "sine",
      "startHz": 120,
      "endHz": 460,
      "durationMs": 600,
      "gain": 0.1
    },
    "click": {
      "wave": "sine",
      "startHz": 560,
      "endHz": 760,
      "durationMs": 75,
      "gain": 0.055
    },
    "open": {
      "wave": "triangle",
      "startHz": 220,
      "endHz": 640,
      "durationMs": 190,
      "gain": 0.085
    },
    "back": {
      "wave": "sine",
      "startHz": 430,
      "endHz": 210,
      "durationMs": 155,
      "gain": 0.075
    }
  },
  "typography": {
    "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', sans-serif",
    "weight": 560,
    "titleSize": "clamp(36px,5.5vw,60px)",
    "bodySize": "15px"
  },
  "effects": {
    "backdropFilter": "none",
    "grain": false,
    "grainOpacity": 0,
    "scanlines": false,
    "reflections": false,
    "blurOnLowPower": true,
    "contrast": "dark"
  }
}
