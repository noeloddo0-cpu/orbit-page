{
  "id": "ultima-transparent",
  "name": "Ultima transparent",
  "description": "Verre fumé transparent inspiré de FF-ULTIMA : voiles sombres, flou profond et accent lime acide.",
  "tokens": {
    "--bg": "#07070b",
    "--surface": "rgba(35,35,42,.28)",
    "--surface-2": "rgba(45,45,59,.5)",
    "--fg": "#f5f5f7",
    "--muted": "rgba(235,235,245,.62)",
    "--accent": "#edf783",
    "--line": "rgba(255,255,255,.11)",
    "--glass": "rgba(24,24,31,.84)",
    "--radius-card": "14px",
    "--radius-panel": "16px",
    "--radius-control": "10px",
    "--shadow-card": "0 14px 36px rgba(0,0,0,.28)",
    "--shadow-panel": "0 24px 70px rgba(0,0,0,.45)",
    "--theme-blur": "blur(28px) saturate(1.4)",
    "--theme-glow": "none",
    "--space-unit": "8px",
    "--font-family": "'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif",
    "--font-weight": "400",
    "--title-size": "clamp(36px,5vw,64px)",
    "--tile-scale": "1.02",
    "--focus-ring": "0 0 0 2px #edf783"
  },
  "animations": {
    "introStyle": "fade",
    "introDurationMs": 1200,
    "screenDurationMs": 240,
    "themeChangeMs": 300,
    "hoverDurationMs": 160,
    "hoverScale": 1.02,
    "focusScale": 1,
    "easing": "cubic-bezier(.2,.7,.2,1)",
    "stepped": false
  },
  "sounds": {
    "intro": {
      "wave": "sine",
      "startHz": 196,
      "endHz": 247,
      "durationMs": 260,
      "gain": 0.01
    },
    "click": {
      "wave": "triangle",
      "startHz": 360,
      "endHz": 300,
      "durationMs": 24,
      "gain": 0.01
    },
    "open": {
      "wave": "sine",
      "startHz": 220,
      "endHz": 330,
      "durationMs": 80,
      "gain": 0.013
    },
    "back": {
      "wave": "sine",
      "startHz": 294,
      "endHz": 220,
      "durationMs": 70,
      "gain": 0.011
    }
  },
  "typography": {
    "family": "'Segoe UI Variable', 'Segoe UI', system-ui, sans-serif",
    "weight": 400,
    "titleSize": "clamp(36px,5vw,64px)",
    "bodySize": "15px"
  },
  "effects": {
    "backdropFilter": "blur(28px) saturate(1.4)",
    "grain": false,
    "grainOpacity": 0,
    "scanlines": false,
    "reflections": false,
    "blurOnLowPower": true,
    "contrast": "dark"
  }
}
