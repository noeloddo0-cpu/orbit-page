{
  "id": "papier",
  "name": "Papier",
  "description": "Un catalogue clair, inspiré des pages imprimées et des jaquettes de cinéma.",
  "tokens": {
    "--bg": "#f1eee6",
    "--surface": "#faf8f2",
    "--surface-2": "#e7e2d8",
    "--fg": "#242521",
    "--muted": "#5f605a",
    "--accent": "#9c4f32",
    "--line": "rgba(36,37,33,.16)",
    "--glass": "#faf8f2",
    "--radius-card": "8px",
    "--radius-panel": "10px",
    "--radius-control": "6px",
    "--shadow-card": "0 1px 3px rgba(35,32,26,.12)",
    "--shadow-panel": "0 8px 24px rgba(35,32,26,.18)",
    "--theme-blur": "none",
    "--theme-glow": "none",
    "--space-unit": "8px",
    "--font-family": "Georgia, 'Times New Roman', serif",
    "--font-weight": "500",
    "--title-size": "clamp(34px,5vw,56px)",
    "--tile-scale": "1.012",
    "--focus-ring": "0 0 0 2px #9c4f32"
  },
  "animations": {
    "introStyle": "minimal",
    "introDurationMs": 1500,
    "screenDurationMs": 220,
    "themeChangeMs": 300,
    "hoverDurationMs": 150,
    "hoverScale": 1.012,
    "focusScale": 1.008,
    "easing": "cubic-bezier(.2,.7,.2,1)",
    "stepped": false
  },
  "sounds": {
    "intro": { "wave": "sine", "startHz": 160, "endHz": 240, "durationMs": 240, "gain": 0.025 },
    "click": { "wave": "sine", "startHz": 520, "endHz": 620, "durationMs": 45, "gain": 0.022 },
    "open": { "wave": "triangle", "startHz": 200, "endHz": 300, "durationMs": 110, "gain": 0.03 },
    "back": { "wave": "sine", "startHz": 330, "endHz": 210, "durationMs": 85, "gain": 0.025 }
  },
  "typography": {
    "family": "Georgia, 'Times New Roman', serif",
    "weight": 500,
    "titleSize": "clamp(34px,5vw,56px)",
    "bodySize": "14px"
  },
  "effects": {
    "backdropFilter": "none",
    "grain": false,
    "grainOpacity": 0,
    "scanlines": false,
    "reflections": false,
    "blurOnLowPower": true,
    "contrast": "light"
  }
}
