{
  "name": "orbit",
  "version": "1.0.35",
  "description": "Carnet personnel de jeux, films et séries pour Windows.",
  "private": true,
  "type": "module",
  "main": "desktop-main.js",
  "scripts": {
    "start": "node bridge.js",
    "app": "electron .",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test scripts/smoke.test.mjs scripts/discord-viewing.test.mjs scripts/statistics.test.mjs scripts/safety.test.mjs scripts/secrets.test.mjs scripts/sessions.test.mjs scripts/security.test.mjs scripts/health.test.mjs scripts/health-center.test.mjs scripts/library-batch.test.mjs scripts/library-import.test.mjs scripts/game-details.test.mjs scripts/migration.test.mjs scripts/library-v2.test.mjs",
    "test:fast": "node --test scripts/smoke.test.mjs scripts/safety.test.mjs scripts/secrets.test.mjs scripts/sessions.test.mjs scripts/security.test.mjs scripts/health.test.mjs scripts/health-center.test.mjs scripts/library-batch.test.mjs scripts/library-import.test.mjs scripts/game-details.test.mjs scripts/migration.test.mjs scripts/library-v2.test.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check --end-of-line auto \"orbit-log.mjs\" \"orbit-backup.mjs\" \"orbit-secrets.mjs\" \"orbit-import.mjs\" \"scripts/safety.test.mjs\" \"scripts/health.test.mjs\" \"scripts/health-center.test.mjs\" \"scripts/library-batch.test.mjs\" \"scripts/library-import.test.mjs\" \"scripts/game-details.test.mjs\" \"scripts/secrets.test.mjs\" \"scripts/security.test.mjs\" \"docs/RELEASE.md\" \"CHANGELOG.md\" \"README.md\" \"package.json\"",
    "check": "node --check bridge.js && node --check desktop-main.js && node --check desktop-preload.cjs && node --check orbit-log.mjs && node --check orbit-backup.mjs && node --check orbit-secrets.mjs && node --check orbit-import.mjs && npm run lint && npm test"
  },
  "dependencies": {
    "discord.js": "^14"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "build": {
    "appId": "fr.noelo.orbit",
    "productName": "Orbit",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-main.js",
      "desktop-preload.cjs",
      "setup.html",
      "bridge.js",
      "bibliotheque.html",
      "launcher.css",
      "launcher.js",
      "og-image.png",
      "confidentialite.html",
      "mentions-legales.html",
      "app-config.json",
      "icon.svg",
      "sw.js",
      "package.json",
      "node_modules/**",
      "steam-local.mjs",
      "steam-achievements.mjs",
      "game-art.mjs",
      "cinema-statistics.mjs",
      "discord-viewing.mjs",
      "orbit-activity.mjs",
      "orbit-library.mjs",
      "orbit-import.mjs",
      "orbit-updates.mjs",
      "orbit-log.mjs",
      "orbit-backup.mjs",
      "orbit-secrets.mjs",
      "themes/**/*.{js,css,json,woff2,webp}",
      "themes/**/LICENSE*",
      "themes/**/*OFL.txt",
      "THIRD_PARTY.md",
      "THIRD-PARTY-NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Orbit-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit",
      "language": "1036",
      "artifactName": "Orbit-Setup-${version}.${ext}"
    }
  },
  "author": "noeloddo0-cpu",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noeloddo0-cpu/orbit-page.git"
  },
  "homepage": "https://github.com/noeloddo0-cpu/orbit-page",
  "engines": {
    "node": ">=22.12.0"
  }
}
